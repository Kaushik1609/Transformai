# =============================================================================
# TransformIQ — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the real values for your environment.
# NEVER commit .env with real secrets to Git.
#
# Phase 1 required values are marked with [P1-REQUIRED].
# Values marked [FUTURE] are used by later phases but must be present for
# Docker Compose to start all services cleanly.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set to "true" to enable a development-only auth bypass (single user, no JWT).
# Must be "false" in staging/production.
DEV_AUTH_BYPASS=true

# Structured security/audit events (Phase 11K). Keep enabled unless auditing
# is explicitly disabled in an isolated test/dev deployment.
SECURITY_AUDIT_ENABLED=true

# --- Backend API ---                                    [P1-REQUIRED]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Database ---                                       [P1-REQUIRED]
# asyncpg URL used by the FastAPI application (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://transformiq:changeme@postgres:5432/transformiq
# Synchronous psycopg2 URL used by Alembic migrations and the /ready check.
DATABASE_SYNC_URL=postgresql://transformiq:changeme@postgres:5432/transformiq
# PostgreSQL container credentials — used by the pgvector/pgvector Docker image.
POSTGRES_USER=transformiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transformiq

# --- Redis ---                                          [P1-REQUIRED]
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---                                       [P1-REQUIRED]
# Public URL that the browser uses to call the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker network URL used for Next.js server-side rendering.
INTERNAL_API_URL=http://backend:8000

# --- Authentication (JWT) ---                           [Phase 11F — L1]
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ISSUER=transformiq
AUTH_AUDIENCE=transformiq-api
AUTH_TOKEN_TYPE=access
# Whether new accounts can self-register via POST /api/v1/auth/register.
# Disable after seeding accounts to close unauthenticated registration.
REGISTRATION_ENABLED=true

# --- OTP policy & delivery ---                          [Phase 11F — L1]
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ISSUES_PER_WINDOW=10
OTP_ISSUE_WINDOW_SECONDS=900
# Store backend: memory | redis
OTP_STORE_BACKEND=memory
# Delivery provider: console | email | sms | resend | brevo
#   console - development only; logs the code when ENVIRONMENT=development
#   email   - SMTP via SMTP_* below, or automatic Brevo/Resend if keys configured
#   brevo   - HTTPS API via BREVO_API_KEY (port 443; 100% free to ANY email address)
#   resend  - HTTPS API via RESEND_API_KEY (port 443; reliable on Render/cloud hosts)
#   sms     - SMS gateway via SMS_* below (gateway client wiring is out of L1 scope)
OTP_PROVIDER=console
# Brevo (Sendinblue) HTTP API (100% free - sends to ANY email address without a custom domain)
BREVO_API_KEY=
BREVO_FROM=ketan.krg.ak@gmail.com
BREVO_FROM_NAME=KaryaSetu AI

# Resend HTTP API (recommended for cloud hosts with verified custom domains)
RESEND_API_KEY=
RESEND_FROM=TransformIQ <onboarding@resend.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TransformIQ
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# --- Rate limiting ---                                  [Phase 11F — L1]
# Backend: memory | redis. Master switch below enables/disables all buckets.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_REQUEST_MAX=10
RATE_LIMIT_OTP_REQUEST_WINDOW=900
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_SOURCE_UPLOAD_MAX=100
RATE_LIMIT_SOURCE_UPLOAD_WINDOW=3600
RATE_LIMIT_TRANSFORMATION_MAX=100
RATE_LIMIT_TRANSFORMATION_WINDOW=3600

# --- LLM Provider ---                                   [FUTURE — Phase 4]
# Supported: fake, openai, gemini (more providers added via adapter in later
# phases)
#   fake   — deterministic offline provider, NO external credentials required.
#   openai — OpenAI-compatible endpoints (OpenAI, OpenCode Zen / big-pickle,
#            etc.) — REQUIRES LLM_API_KEY.
#   gemini — Google Gemini via its OpenAI-compatible endpoint
#            (https://generativelanguage.googleapis.com/v1beta/openai/)
#            — REQUIRES LLM_API_KEY.
# Selection is explicit: configuring a real provider ("openai"|"gemini") without
# LLM_API_KEY raises a clear configuration error at use time instead of silently
# using the fake provider (Phase 11J-A). The API key is read from LLM_API_KEY and
# consumed from the local, gitignored .env only. NEVER commit a real key.
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
# When LLM_PROVIDER=gemini, set LLM_MODEL to a currently supported Gemini
# model. Older models such as gemini-1.5-flash and gemini-2.5-flash return 404
# for new accounts; e.g. use gemini-3.6-flash (verify with Gemini API docs).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_EXECUTION_MODE=auto

# --- Offline / Local LLM Execution & Deployment Readiness (Phase 2I) ---
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=llama-3-8b
LOCAL_LLM_TIMEOUT=60

# --- LLM Resilience ---                                 [FUTURE — Phase 11D]
# Optional fallback provider ("fake", "openai", "gemini", or blank for none).
# Fallback is only used when configured; never required.
LLM_FALLBACK_PROVIDER=

# --- Embedding Provider ---                             [FUTURE — Phase 11G]
# Supported: fake (deterministic, offline/tests), openai (real embeddings).
# The fake provider needs no credentials and is the safe default. Selection is
# explicit: configuring "openai" without EMBEDDING_API_KEY raises a clear
# configuration error (no silent fake fallback). The API key is read from
# EMBEDDING_API_KEY and consumed from the local, gitignored .env only. NEVER
# commit a real key.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
# Optional base URL for OpenAI-compatible embedding endpoints (blank = default).
EMBEDDING_BASE_URL=
# Per-request timeout (seconds) and max retries. Ensure
# timeout * (retries + 1) stays well below the worker job timeout.
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_RETRIES=2

# --- File Storage ---                                   [FUTURE — Phase 3]
# Supported: local (tests/offline/FakeLLMProvider), s3 (production, S3/MinIO).
# Selecting s3 with incomplete config fails loudly — it NEVER falls back to
# local disk. Credentials come only from the environment (never committed).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# S3/MinIO settings (used when STORAGE_BACKEND=s3)
# STORAGE_ENDPOINT empty = AWS S3; set it for MinIO/other S3-compatible targets
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=transformiq
STORAGE_REGION=us-east-1
# MinIO requires path-style addressing (AWS S3 auto-detects)
STORAGE_PATH_STYLE=true

# --- Optional local MinIO (Phase 12A) ---
# Used ONLY with the dedicated override: docker compose -f docker-compose.yml
# -f docker-compose.minio.yml up -d   (bucket is created automatically)
MINIO_ROOT_USER=transformiq
MINIO_ROOT_PASSWORD=transformiq-secret

# --- File Upload Limits ---                             [FUTURE — Phase 3]
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# --- Malware Scanning (Phase 12D-A) ---
# Local-only source-file scanning. NO third-party upload/scanning services.
#   MALWARE_SCAN_ENABLED=true   -> scan uploaded bytes before persistence
#   MALWARE_SCAN_REQUIRED=true  -> reject ingestion if scanner unavailable/error;
#                                  do NOT silently bypass a required scan.
#   MALWARE_SCANNER=fake        -> deterministic offline scanner (tests/dev)
#   MALWARE_SCANNER=clamav      -> local clamd service (CLAMAV_HOST below)
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER=fake
# Local ClamAV clamd host/port (used when MALWARE_SCANNER=clamav).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# --- Worker ---                                         [P1-REQUIRED]
# Number of worker processes to launch (Phase 11L-D).  Each RQ 2.0 worker
# process handles one job at a time; vertical scaling = multiple processes.
WORKER_COUNT=1
WORKER_JOB_TIMEOUT=605

# --- Caching (Phase 11L-A) ---
# Master switch. Disabled by default to preserve historical behavior.
# CACHE_ENABLED=false
# Backend: memory (offline/tests) | redis (production).
# CACHE_BACKEND=memory
# Time-to-live for cached LLM outputs (seconds).
# CACHE_TTL_SECONDS=3600
# Version tag embedded in cache keys; change to hard-expire all caches.
# CACHE_KEY_VERSION=v1

# --- Artifact Integrity & Provenance (Phase 11M) ---
# POST-GENERATION provenance layer; never touches the AI pipeline.
# Provider: fake (offline/tests) | real (production adapter) | none (local hashes
# + verification only, no ledger reference).
# INTEGRITY_PROVIDER=fake
# If true, record a ledger reference for every persisted artifact during
# generation. Artifact persistence is independent of the ledger (fail-open).
# INTEGRITY_RECORD_ENABLED=true
# Content hashing algorithm.
# INTEGRITY_ALGORITHM=sha256
# Real-ledger target. PRODUCTION-CONFIGURATION-REQUIRED. Never commit a literal
# value here; supply only via the production secret store.
# INTEGRITY_LEDGER_URL=
# Secret-manager reference to the ledger credential (never a literal).
# INTEGRITY_LEDGER_CREDENTIAL=

# --- Evidence / Fact Verification (Phase 11N) ---
# On-demand factual verification of generated outputs against project-scoped
# source evidence. Additive to the Phase 8 verification pipeline; never runs
# inside the generation workflow.
# FACT_VERIFICATION_ENABLED=true
# Upper bound on extracted claims checked per request.
# FACT_VERIFICATION_MAX_CLAIMS=20
# Source chunks retrieved per claim (RAG top-k, project-scoped).
# FACT_VERIFICATION_TOP_K=3
# Minimum cosine similarity for retrieved evidence (0.0 = no filtering).
# FACT_VERIFICATION_MIN_SIMILARITY=0.0
# Maximum citations surfaced per claim in the response.
# FACT_VERIFICATION_MAX_EVIDENCE_PER_CLAIM=3

# --- Production Hardening (Phase 13) ---
# Token revocation (Phase 13A). Every JWT carries a unique jti claim; logout
# registers it so the token cannot be replayed.
# AUTH_TOKEN_REVOCATION_STORE=memory          # memory | redis (shared, prod)
# AUTH_REVOKED_TOKEN_MAX=100000               # bounded in-memory denylist cap

# Audit sink (Phase 13D). "memory" keeps the bounded in-process store;
# "database" also persists events to the security_events table (requires
# migrations at alembic head) and serves the security-events API from it.
# SECURITY_AUDIT_SINK=memory
# SECURITY_AUDIT_MEMORY_MAX_EVENTS=5000

# Ingestion resource budgets (Phase 13E). Documents exceeding any cap fail
# ingestion with a controlled error; they are never truncated silently.
# MAX_PDF_PAGES=500
# MAX_EXTRACTED_CHARS=2000000
# INPUT_MAX_TEXT_LENGTH=500000
# MAX_SOURCE_CHUNKS=10000

# Stale-job reaper (Phase 13G). Fails transformation jobs stuck in "running"
# past the grace period (workers that died mid-job). Grace must be greater
# than WORKER_JOB_TIMEOUT (enforced by settings).
# STALE_JOB_REAPER_ENABLED=true
# STALE_TRANSFORMATION_JOB_GRACE_SECONDS=1200
# STALE_JOB_REAPER_INTERVAL_SECONDS=600

# Production config guards (Phase 13F): in staging/production settings REFUSE
# to boot with a development AUTH_SECRET_KEY, a console OTP provider, an
# in-memory OTP store, or a wildcard CORS origin.
