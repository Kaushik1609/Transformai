# =============================================================================
# TransformIQ Backend — .dockerignore
# =============================================================================
# Keeps the backend build context lean and never copies secrets/local data
# into the image.

# VCS / CI
.git
.gitignore

# Local test + coverage artifacts
tests
.pytest_cache
.coverage
htmlcov
.tox
.nox
.mypy_cache
.ruff_cache

# Python bytecode / build artifacts
__pycache__
*.py[cod]
*.egg-info
build
dist
.eggs

# Environment / secrets (never bake into the image)
.env
.env.*
*.env

# Local storage (mounted at runtime, never baked)
storage

# IDE / OS noise
.vscode
.idea
*.swp
.DS_Store
Thumbs.db