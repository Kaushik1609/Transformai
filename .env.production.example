# =============================================================================
# TransformIQ — Production Environment Template
# =============================================================================
# Copy this file to `.env.production` and replace EVERY <...> placeholder with
# a real value BEFORE deploying. `.env.production` is gitignored.
#
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml build
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# Fail-closed guarantees (enforced in backend/app/core/config.py):
#   * ENVIRONMENT=production refuses to boot with fake/mock LLM or embedding
#     providers, a real provider without its API key, memory-backed shared
#     stores, a disabled audit emitter, or the in-memory audit sink.
#   * STORAGE_BACKEND=s3 in staging/production requires bucket + access key +
#     secret key (there is no silent local fallback).
# =============================================================================

# --- Application ------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Authentication ---------------------------------------------------------
# MUST stay false in staging/production (enforced).
DEV_AUTH_BYPASS=false
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=<REPLACE_WITH_STRONG_RANDOM_SECRET>
# Comma-separated browser origins (HTTPS). Never '*'  (enforced).
ALLOWED_ORIGINS=<REPLACE_WITH_HTTPS_FRONTEND_ORIGIN>
# Keep enabled unless you truly need invite-only operation.
REGISTRATION_ENABLED=true

# --- One-time passwords (email delivery; console is refused, enforced) ------
OTP_PROVIDER=email
OTP_STORE_BACKEND=redis
SMTP_HOST=<REPLACE_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<REPLACE_SMTP_USER>
SMTP_PASSWORD=<REPLACE_SMTP_PASSWORD>
SMTP_FROM=<REPLACE_SMTP_FROM_ADDRESS>

# --- Database ---------------------------------------------------------------
# docker-compose.prod.yml builds DATABASE_URL / DATABASE_SYNC_URL from these.
POSTGRES_USER=<REPLACE_DB_USER>
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_DB_PASSWORD>
POSTGRES_DB=transformiq

# Optional: point at an externally-managed PostgreSQL instead of the bundled
# container by uncommenting these (then the bundled `postgres` service is unused):
#DATABASE_URL=postgresql+asyncpg://user:pass@db.example.com:5432/transformiq
#DATABASE_SYNC_URL=postgresql://user:pass@db.example.com:5432/transformiq

# --- Redis ------------------------------------------------------------------
# Optional: point at an externally-managed Redis instead of the bundled one:
#REDIS_URL=redis://redis:6379/0

# --- Malware scanning (local ClamAV daemon) ---------------------------------
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_REQUIRED=true
MALWARE_SCANNER=clamav

# --- Storage (S3-compatible; MinIO is bundled in docker-compose.prod.yml) ---
# With the bundled MinIO these access keys MUST match MINIO_ROOT_USER /
# MINIO_ROOT_PASSWORD below. For an external S3 provider set STORAGE_ENDPOINT
# to its service URL (or leave it for AWS-style auto-detection).
STORAGE_BACKEND=s3
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=<REPLACE_MINIO_ACCESS_KEY>
STORAGE_SECRET_KEY=<REPLACE_MINIO_SECRET_KEY>
STORAGE_BUCKET=transformiq
STORAGE_REGION=us-east-1

# --- MinIO root credentials (used to bootstrap the bundled MinIO) -----------
# Keep these strong; they also serve as the S3 API credentials above.
MINIO_ROOT_USER=<REPLACE_MINIO_ROOT_USER>
MINIO_ROOT_PASSWORD=<REPLACE_MINIO_ROOT_PASSWORD>

# --- LLM / Embedding providers (fake/unkeyed real providers are refused) ----
LLM_PROVIDER=openai
LLM_API_KEY=<REPLACE_LLM_API_KEY>
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=<REPLACE_EMBEDDING_API_KEY>
EMBEDDING_MODEL=text-embedding-3-small

# --- Security audit (must stay enabled with the database sink, enforced) ----
SECURITY_AUDIT_ENABLED=true
SECURITY_AUDIT_SINK=database

# --- Shared stores must be Redis across replicas (enforced) -----------------
AUTH_TOKEN_REVOCATION_STORE=redis
RATE_LIMIT_BACKEND=redis
CACHE_ENABLED=true
CACHE_BACKEND=redis

# --- Worker ----------------------------------------------------------------
# RQ worker processes per worker container. Add replicas at deployment time:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --scale worker=2
WORKER_COUNT=1

# --- Frontend ----------------------------------------------------------------
# Browser-reachable backend URL, baked into the frontend image at build time.
# Under this compose file use the published backend port or a reverse proxy,
# e.g. https://api.example.com  (not http://backend:8000 — browsers cannot
# resolve container names).
NEXT_PUBLIC_API_URL=<REPLACE_WITH_BROWSER_REACHABLE_BACKEND_URL>

# Optional: bind the published backend/frontend ports to different HOST ports
# (useful when the host already uses 8000/3000, e.g. during staged migrations).
#BACKEND_BIND_PORT=18000
#FRONTEND_BIND_PORT=13000