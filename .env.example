# =============================================================================
# TransformIQ — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the real values for your environment.
# NEVER commit .env with real secrets to Git.
#
# Phase 1 required values are marked with [P1-REQUIRED].
# Values marked [FUTURE] are used by later phases but must be present for
# Docker Compose to start all services cleanly.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set to "true" to enable a development-only auth bypass (single user, no JWT).
# Must be "false" in staging/production.
DEV_AUTH_BYPASS=true

# --- Backend API ---                                    [P1-REQUIRED]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Database ---                                       [P1-REQUIRED]
# asyncpg URL used by the FastAPI application (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://transformiq:changeme@postgres:5432/transformiq
# Synchronous psycopg2 URL used by Alembic migrations and the /ready check.
DATABASE_SYNC_URL=postgresql://transformiq:changeme@postgres:5432/transformiq
# PostgreSQL container credentials — used by the pgvector/pgvector Docker image.
POSTGRES_USER=transformiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transformiq

# --- Redis ---                                          [P1-REQUIRED]
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---                                       [P1-REQUIRED]
# Public URL that the browser uses to call the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker network URL used for Next.js server-side rendering.
INTERNAL_API_URL=http://backend:8000

# --- Authentication (JWT) ---                           [FUTURE — Phase 2]
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM Provider ---                                   [FUTURE — Phase 4]
# Supported: openai (more providers added via adapter in later phases)
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# --- Embedding Provider ---                             [FUTURE — Phase 5]
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- File Storage ---                                   [FUTURE — Phase 3]
# Supported: local (Phase 1-2), s3 (Phase 3+)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# S3/MinIO settings (used when STORAGE_BACKEND=s3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=transformiq
STORAGE_REGION=us-east-1

# --- File Upload Limits ---                             [FUTURE — Phase 3]
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# --- Worker ---                                         [P1-REQUIRED]
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT=300
