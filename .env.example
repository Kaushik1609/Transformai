# =============================================================================
# TransformIQ — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in the real values for your environment.
# NEVER commit .env with real secrets to Git.
#
# Phase 1 required values are marked with [P1-REQUIRED].
# Values marked [FUTURE] are used by later phases but must be present for
# Docker Compose to start all services cleanly.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Set to "true" to enable a development-only auth bypass (single user, no JWT).
# Must be "false" in staging/production.
DEV_AUTH_BYPASS=true

# --- Backend API ---                                    [P1-REQUIRED]
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Database ---                                       [P1-REQUIRED]
# asyncpg URL used by the FastAPI application (SQLAlchemy async).
DATABASE_URL=postgresql+asyncpg://transformiq:changeme@postgres:5432/transformiq
# Synchronous psycopg2 URL used by Alembic migrations and the /ready check.
DATABASE_SYNC_URL=postgresql://transformiq:changeme@postgres:5432/transformiq
# PostgreSQL container credentials — used by the pgvector/pgvector Docker image.
POSTGRES_USER=transformiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transformiq

# --- Redis ---                                          [P1-REQUIRED]
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---                                       [P1-REQUIRED]
# Public URL that the browser uses to call the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal Docker network URL used for Next.js server-side rendering.
INTERNAL_API_URL=http://backend:8000

# --- Authentication (JWT) ---                           [Phase 11F — L1]
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ISSUER=transformiq
AUTH_AUDIENCE=transformiq-api
AUTH_TOKEN_TYPE=access
# Whether new accounts can self-register via POST /api/v1/auth/register.
# Disable after seeding accounts to close unauthenticated registration.
REGISTRATION_ENABLED=true

# --- OTP policy & delivery ---                          [Phase 11F — L1]
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ISSUES_PER_WINDOW=10
OTP_ISSUE_WINDOW_SECONDS=900
# Store backend: memory | redis
OTP_STORE_BACKEND=memory
# Delivery provider: console | email | sms
#   console - development only; logs the code when ENVIRONMENT=development
#   email   - SMTP via SMTP_* below
#   sms     - SMS gateway via SMS_* below (gateway client wiring is out of L1 scope)
OTP_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=TransformIQ
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# --- Rate limiting ---                                  [Phase 11F — L1]
# Backend: memory | redis. Master switch below enables/disables all buckets.
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_ENABLED=true
RATE_LIMIT_OTP_REQUEST_MAX=10
RATE_LIMIT_OTP_REQUEST_WINDOW=900
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_SOURCE_UPLOAD_MAX=100
RATE_LIMIT_SOURCE_UPLOAD_WINDOW=3600
RATE_LIMIT_TRANSFORMATION_MAX=100
RATE_LIMIT_TRANSFORMATION_WINDOW=3600

# --- LLM Provider ---                                   [FUTURE — Phase 4]
# Supported: openai, gemini (more providers added via adapter in later phases)
#   openai — OpenAI-compatible endpoints (OpenAI, OpenCode Zen / big-pickle, etc.)
#   gemini — Google Gemini via its OpenAI-compatible endpoint
#            (https://generativelanguage.googleapis.com/v1beta/openai/)
# The API key is read from LLM_API_KEY and consumed from the local, gitignored
# .env only. NEVER commit a real key.
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
# When LLM_PROVIDER=gemini, set LLM_MODEL to a currently supported Gemini
# model. Older models such as gemini-1.5-flash and gemini-2.5-flash return 404
# for new accounts; e.g. use gemini-3.6-flash (verify with Gemini API docs).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# --- LLM Resilience ---                                 [FUTURE — Phase 11D]
# Optional fallback provider ("fake", "openai", "gemini", or blank for none).
# Fallback is only used when configured; never required.
LLM_FALLBACK_PROVIDER=

# --- Embedding Provider ---                             [FUTURE — Phase 5]
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- File Storage ---                                   [FUTURE — Phase 3]
# Supported: local (Phase 1-2), s3 (Phase 3+)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/app/storage
# S3/MinIO settings (used when STORAGE_BACKEND=s3)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=transformiq
STORAGE_REGION=us-east-1

# --- File Upload Limits ---                             [FUTURE — Phase 3]
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# --- Worker ---                                         [P1-REQUIRED]
WORKER_CONCURRENCY=2
WORKER_JOB_TIMEOUT=605
